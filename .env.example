# -----------------------------------------------------------------------------
# YuliusBox Environment Configuration Template
# -----------------------------------------------------------------------------

# Upstash Redis & Rate Limiting (Used for API throttling and caching)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Gotenberg Service (Used for Office documents & URL to PDF conversion)
# Example: http://your-gotenberg-instance:3000
GOTENBERG_URL="http://localhost:3000"

# VPS Video Extraction Microservice (FastAPI + yt-dlp)
VPS_API_URL="http://your-vps-ip:8000/api/extract"
VPS_API_KEY="your_secure_vps_api_key"

# Optional: Residential Proxy for restricted platforms in VPS microservice
RESIDENTIAL_PROXY_URL=""

# Cloudflare Worker Backend (Used for AI utilities & Speed Test)
NEXT_PUBLIC_CF_WORKER_URL="https://your-worker-subdomain.workers.dev"

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID="G-CH0GSRDG6C"
